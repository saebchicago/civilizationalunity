+.seminar__series h2{font-size:clamp(1.9rem,3.8vw,3.1rem);line-height:1.04;font-weight:400;max-width:24ch;margin-bottom:1rem}
+.seminar__series .lede{max-width:46rem}
 @media(min-width:64rem){.seminar__grid{grid-template-columns:.78fr 1.22fr}}
 
